    {
     "metric": "latencyMs.textLayer.p95",
     "max": 2000
    },
    {
     "metric": "latencyMs.ocr.p95",
     "max": 45000
    }
   ]
  },
  "perturb": {
   "dir": "out/perturb",
   "gold": "eval/gold.json",

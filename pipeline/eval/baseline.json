   "targets": [
    {
     "metric": "fields.autoAcceptPrecision",
     "min": 99
    },
    {
     "metric": "stp.precision",
     "min": 98
    }
   ]
  },
  "held_real": {
   "dir": "out/held_real",
   "gold": "eval/heldout/gold_real.json",
   "required": false,
   "note": "42 real/realistic public docs, layouts never seen",
   "targets": [
    {
     "metric": "fields.autoAcceptPrecision",
     "min": 99
    },
    {
     "metric": "fields.catchRate",
     "min": 90
    }
   ]
  },
  "held_gen": {
   "dir": "out/held_gen",

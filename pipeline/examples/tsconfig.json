{
  // Type-checks the examples against the package source (src/ = lib/ in the repo, the copied sources in the package).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "rootDir": "..",
    "lib": ["es2023", "dom"],
    "paths": { "freight-extract": ["../src/index.ts"] }
  },
  "include": ["*.ts"]
}

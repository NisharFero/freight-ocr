# Copy to frontend/.env.local and fill in. Never commit .env.local.
# One entry per reviewer: user:sha256hex  (generate with: npm run hash-password -w frontend -- <user> '<password>')
AUTH_USERS=
# Where the OCR models live (relative to frontend/)
OCR_MODEL_DIR=../pipeline/models/ppocr-v4
# 1 = never auto-accept, only log what would have been accepted (recommended for the first 2 weeks)
SHADOW_MODE=1
